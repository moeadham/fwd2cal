{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "drive",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "src",
        "lib/agents/calendar"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "pubsub": {
      "port": 8085
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    }
  },
  "hosting": {
    "public": "public-drive",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/not-found",
        "destination": "/404.html"
      },
      {
        "source": "/insufficient-permissions",
        "destination": "/insufficient-permissions.html"
      },
      {
        "source": "/signup-with-google.png",
        "destination": "/signin-with-google.png"
      },
      {
        "source": "/v2/signup",
        "function": "v2driveSignup"
      },
      {
        "source": "/v2/oauthCallback",
        "function": "v2driveOauthCallback"
      },
      {
        "source": "/v2/inboundCallback",
        "function": "v2driveInboundCallback"
      },
      {
        "source": "/v2/fullScopeSignup",
        "function": "v2driveFullScopeSignup"
      },
      {
        "source": "/v2/organizeAction",
        "function": "v2driveOrganizeAction"
      }
    ]
  }
}
