{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "drive",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "src",
        "lib/agents/calendar"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/v2/driveSignup",
        "function": "v2driveSignup"
      },
      {
        "source": "/v2/driveOauthCallback",
        "function": "v2driveOauthCallback"
      },
      {
        "source": "/v2/resendInboundCallback",
        "function": "v2resendInboundCallback"
      }
    ]
  }
}
