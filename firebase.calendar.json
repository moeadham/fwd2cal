{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "calendar",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "src",
        "lib/agents/drive"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "pubsub": {
      "port": 8085
    },
    "hosting": {
      "port": 5002
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    }
  },
  "hosting": {
    "target": "calendar",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [],
    "rewrites": [
      {
        "source": "/not-found",
        "destination": "/404.html"
      },
      {
        "source": "/insufficient-permissions",
        "destination": "/insufficient-permissions.html"
      },
      {
        "source": "/signup-with-google.png",
        "destination": "/signin-with-google.png"
      },
      {
        "source": "/auth/verifyAdditionalEmail",
        "function": "verifyAdditionalEmail"
      },
      {
        "source": "/auth/inviteAdditionalAttendees",
        "function": "inviteAdditionalAttendees"
      },
      {
        "source": "/auth/oauthCallback",
        "function": "oauthCallback"
      },
      {
        "source": "/signup",
        "function": "v2signup"
      },
      {
        "source": "/v2/signup",
        "function": "v2signup"
      },
      {
        "source": "/v2/oauthCallback",
        "function": "v2oauthCallback"
      },
      {
        "source": "/v2/resendInboundCallback",
        "function": "v2resendInboundCallback"
      },
      {
        "source": "/v2/verifyAdditionalEmail",
        "function": "v2verifyAdditionalEmail"
      },
      {
        "source": "/v2/inviteAdditionalAttendees",
        "function": "v2inviteAdditionalAttendees"
      }
    ]
  }
}
